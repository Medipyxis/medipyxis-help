{
  "title": "Team Chat overview",
  "source": "modules/team-chat/overview",
  "url": "https://help.medipyxis.com/modules/team-chat/overview/",
  "claims": [
    {
      "id": "tc-20",
      "claim": "Team Chat is where your team messages each other inside Medipyxis: direct messages and group chats with the people at your facility. Open it from Team Chat in the sidebar.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "label: \"Team Chat\",",
          "paths": [
            "frontend/src/constants/navigation.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Internal team communication for {currentFacility?.name}",
          "paths": [
            "frontend/src/pages/TeamChat.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Team discussions and direct messages only",
          "paths": [
            "frontend/src/pages/TeamChat.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "useFacilityUsers",
          "paths": [
            "frontend/src/pages/TeamChat.tsx"
          ],
          "expect": "present"
        }
