{
  "title": "Add a new employee",
  "source": "modules/hr-compliance/new-employee",
  "url": "https://help.medipyxis.com/modules/hr-compliance/new-employee/",
  "claims": [
    {
      "id": "hrn-01",
      "claim": "Create a user account and set up access from a single Create New User form. Provider fields appear automatically when you pick a role that can see patients.",
      "checks": [
        {
          "type": "grep",
          "pattern": "{userId ? \"Edit User Profile\" : \"Create New User\"}",
          "paths": [
            "frontend/src/pages/HRNewUserPage.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<HRNewUserPage />",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "!!r && !(NON_CLINICAL_EXCLUDED_ROLES as readonly string[]).includes(r.toLowerCase());",
          "paths": [
            "frontend/src/pages/HRNewUserPage.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrn-02",
      "claim": "Before you start: have the employee's legal name, email, phone, role, facilities, and for providers their credentialing details (NPI, license, DEA, taxonomy).",
