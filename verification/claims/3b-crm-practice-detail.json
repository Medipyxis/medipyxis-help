        {
          "type": "grep",
          "pattern": "marketing collateral",
          "paths": [
            "frontend/src/pages/CrmPracticeDetail.tsx"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
        }
      ],
      "status": "removed",
      "reason": "Overview field list and Docs content types were not found as described; reworded to the fields the page renders."
    },
