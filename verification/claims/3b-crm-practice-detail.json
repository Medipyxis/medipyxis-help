{
  "title": "Work with a practice detail record",
  "source": "modules/crm/practice-detail",
  "url": "https://help.medipyxis.com/modules/crm/practice-detail/",
  "claims": [
    {
      "id": "crp-01",
      "claim": "View a practice's profile and contacts, review activity history, and log activity from the practice detail page.",
      "checks": [
        {
          "type": "grep",
          "pattern": "path: \"/facility/:facilityId/crm-practice-detail/:practiceId\",",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<CrmPracticeDetail />",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "crp-02",
      "claim": "Click CRM in the sidebar, find the practice with the search bar or a tab, and click it to open its detail page.",
      "checks": [
        {
          "type": "grep",
          "pattern": "label: \"CRM\",",
          "paths": [
            "frontend/src/constants/navigation.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "placeholder=\"Search practices...\"",
          "paths": [
            "frontend/src/pages/Crm.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "? `/facility/${targetId}/crm-practice-detail/${practice.id}`",
          "paths": [
            "frontend/src/pages/Crm.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "crp-03",
      "claim": "The practice detail panel has three tabs: Overview, Activity, Docs.",
      "checks": [
        {
          "type": "grep",
          "pattern": "...(showProviders ? [{ id: \"providers\", label: \"Providers\", icon: \"🩺\" }] : []),",
          "paths": [
            "frontend/src/pages/CrmPracticeDetail.tsx"
          ],
          "expect": "absent",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Residential practices (SNF/ALF) also get Providers, Residents and Clinical Notes tabs."
    },
    {
      "id": "crp-04",
      "claim": "Overview shows specialty, NPI, assigned BD rep and all linked contacts; Activity shows date, rep name, outcome and notes for each entry; Docs holds referral agreements, contracts and marketing collateral.",
      "checks": [
        {
          "type": "grep",
          "pattern": "Referral agreements",
          "paths": [
            "frontend/src/pages/CrmPracticeDetail.tsx"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
