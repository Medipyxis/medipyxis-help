      "claim": "Side panel shows progress and invitation details: invited by, sent to, expires; Back returns to an earlier step.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "% complete · resumable",
          "paths": [
            "frontend/src/pages/vendor/VendorOnboardingPage.tsx"
