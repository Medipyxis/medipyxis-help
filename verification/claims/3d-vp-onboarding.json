{
  "title": "Onboard your company on the vendor portal",
  "source": "vendor-portal/onboarding-your-company",
  "url": "https://help.medipyxis.com/vendor-portal/onboarding-your-company/",
  "claims": [
    {
      "id": "vpb-01",
      "claim": "A clinic invites your company; the email links to the onboarding wizard at /vendor/onboarding.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "// W7: Clinic invites a vendor by email. Creates a vendor_invitations row",
          "paths": [
            "backend/supabase/functions/vendor-invite/index.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<Route path=\"/onboarding\" element={<VendorOnboardingPage />} />",
          "paths": [
            "frontend/src/pages/vendor/VendorRoutes.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpb-02",
      "claim": "Five steps: Profile, BAA, Modalities, Staff, Catalog push.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const STEPS = ['Profile', 'BAA', 'Modalities', 'Staff', 'Catalog push'] as const;",
          "paths": [
            "frontend/src/pages/vendor/VendorOnboardingPage.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpb-03",
      "claim": "Each step is saved when you continue, and the same link resumes where you left off.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "body: { step: 0, token, action: 'get_progress' },",
          "paths": [
            "frontend/src/pages/vendor/VendorOnboardingPage.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "setCurrentStep(data.progress?.current_step ?? 1);",
          "paths": [
            "frontend/src/pages/vendor/VendorOnboardingPage.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpb-04",
      "claim": "The invitation link expires 30 days after it was created.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "expires_at            timestamptz not null default (now() + interval '30 days'),",
          "paths": [
            "backend/supabase/migrations/20260727000001_vendor_directory_onboarding.sql"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "if (new Date(data.expires_at) < new Date()) return null;",
          "paths": [
            "backend/supabase/functions/vendor-onboarding-step/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpb-05",
      "claim": "Steps 4 and 5 require being signed in as an Admin.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "return json({ error: \"Authentication required for steps 4-5\" }, 401, cors);",
          "paths": [
            "backend/supabase/functions/vendor-onboarding-step/index.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "return json({ error: \"Only vendor_admin can complete onboarding\" }, 403, cors);",
          "paths": [
            "backend/supabase/functions/vendor-onboarding-step/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpb-06",
      "claim": "Inviting an already-registered company links the invitation to it.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "// crm_vendors is a global registry, so link the invitation to the existing",
          "paths": [
            "backend/supabase/functions/vendor-invite/index.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "vendor_id: existingVendorId,",
          "paths": [
            "backend/supabase/functions/vendor-invite/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
