    {
      "id": "lfac-07",
      "claim": "Inactive: no new activity can be logged against it.",
      "checks": [
        {
          "type": "grep",
          "pattern": "FACILITY_INACTIVE",
          "paths": [
            "backend/supabase/functions"
          ],
          "expect": "present",
          "fixed": true,
          "note": "a server-side write guard would reject activity for an inactive facility"
        }
      ],
      "finding": "No write path checks facility status: no edge function in v1.1.345 rejects writes for an inactive facility (no FACILITY_INACTIVE or equivalent guard found). The verified effect is that the facility drops out of users' facility lists (frontend/src/contexts/FacilityContext.tsx:388).",
      "proposed_text": "Inactive: the facility no longer appears in anyone's facility list; its data is kept.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": ".in(\"id\", facilityIds)",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "present",
          "fixed": true
