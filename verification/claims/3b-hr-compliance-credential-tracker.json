{
  "title": "Monitor credentials and license expiry",
  "source": "modules/hr-compliance/credential-tracker",
  "url": "https://help.medipyxis.com/modules/hr-compliance/credential-tracker/",
  "claims": [
    {
      "id": "hrc-01",
      "claim": "The Credential Tracker shows license and certification status for your staff. Credentials are added by uploading them in the Credential Tracker.",
      "checks": [
        {
          "type": "grep",
          "pattern": "path: \"/hr-credential-tracker\",",
          "paths": [
            "frontend/src/pages/HrCockpit.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<span className=\"hidden sm:inline\">Upload Credential</span>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-02",
      "claim": "Open HR & Compliance and click Credential Tracker. The tracker lists employees with their credentials, one row per employee, with columns Employee Information, Role & Territory, Credentials Summary, Next Expiration, Overall Status, Credential Breakdown and Actions.",
      "checks": [
        {
          "type": "grep",
          "pattern": "title: \"Credential Tracker\",",
          "paths": [
            "frontend/src/pages/HrCockpit.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Employee Information",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Role & Territory",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Credentials Summary",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Next Expiration",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Overall Status",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Credential Breakdown",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{userGroup.validCredentials} Valid",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{userGroup.missingCredentials} Missing",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "title=\"Add/Update Credential\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-03",
      "claim": "Each row shows Employee (name and role), Credential Type, Expiration Date and Status.",
      "checks": [
        {
          "type": "grep",
          "pattern": ">Credential Type<",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "The table is grouped per employee with different columns (Employee Information, Role & Territory, Credentials Summary, Next Expiration, Overall Status, Credential Breakdown, Actions)."
    },
    {
      "id": "hrc-04",
      "claim": "Filter by credential type, status, role and territory, or click Export CSV to download the list.",
      "checks": [
        {
          "type": "grep",
          "pattern": "<option value=\"\">All Types</option>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<option value=\"\">All Statuses</option>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<option value=\"\">All Roles</option>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<option value=\"\">All Territories</option>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<span className=\"hidden sm:inline\">Export CSV</span>",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-05",
      "claim": "Status from the expiration date: Valid (more than 5 days), Expiring Soon (within 5 days), Expired (past). Missing: recorded as missing with no expiration date.",
      "checks": [
        {
          "type": "grep",
          "pattern": "} else if (daysUntilExpiration <= 5) {",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "if (daysUntilExpiration < 0) {",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "return storedStatus === \"missing\" ? \"missing\" : \"valid\";",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{ value: 'expiring', label: 'Expiring Soon' },",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-06",
      "claim": "Missing means a required credential is not yet on file.",
      "checks": [
        {
          "type": "grep",
          "pattern": "required_credentials",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "REQUIRED_CREDENTIALS",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "There is no list of required credentials per role; Missing is only a stored status on a credential with no expiration date."
    },
    {
      "id": "hrc-07",
      "claim": "Click Upload Credential, select the Employee and Credential Type (RN License, NP License, CPR Certification, WOCN Certification, NPI, DEA License, State Controlled Substance License, BLS Certification, or Other), and enter the Expiration Date (required).",
      "checks": [
        {
          "type": "grep",
          "pattern": "  'RN License',",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "  'WOCN Certification',",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "  'State Controlled Substance License',",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "  'BLS Certification',",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "  'Other',",
          "paths": [
            "frontend/src/types/hrCredentials.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "toast.error(\"Please select an employee, credential type, and expiration date\");",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-08",
      "claim": "Attach the Document (PDF or image) and add Notes; Territory is set to National.",
      "checks": [
        {
          "type": "grep",
          "pattern": "<select title=\"Territory\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "absent",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Territory starts as National but there is a Territory dropdown you can change."
    },
    {
      "id": "hrc-09",
      "claim": "Choose the Territory (it starts as National), attach the Document (PDF, JPG or PNG), and add Notes if needed. Save; the credential appears with its status.",
      "checks": [
        {
          "type": "grep",
          "pattern": "employeeTerritory: \"National\",",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<select title=\"Territory\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "accept=\".pdf,.jpg,.jpeg,.png\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "notes: uploadForm.notes || null,",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "toast.success(\"Credential uploaded successfully!\");",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-10",
      "claim": "Upload the renewed credential for the same employee and type. When one already exists, the dialog reads Update Credential, fills in the current details, and saving overwrites the previous credential.",
      "checks": [
        {
          "type": "grep",
          "pattern": "// Check for existing credential when employee and credential type change",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "// Pre-populate form with existing credential data",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "? \"Update Credential\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "\"Credential updated successfully! The previous credential has been overwritten.\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-11",
      "claim": "Send Reminder appears on credential rows and shows “Reminder sent successfully!”, but it does not send anything — it is not connected to email or notifications.",
      "checks": [
        {
          "type": "grep",
          "pattern": "title=\"Send Reminder\"",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "console.log(\"Sending reminder for credential:\", selectedCredential);",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "toast.success(\"Reminder sent successfully!\");",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "functions.invoke",
          "paths": [
            "frontend/src/pages/HRCredentialTracker.tsx"
          ],
          "expect": "absent",
          "fixed": true
        }
      ]
    },
    {
      "id": "hrc-13",
      "claim": "If a clinician's license lapses, an administrator can set their status to Inactive in Facility Users so they cannot keep documenting and billing visits.",
      "checks": [
        {
          "type": "grep",
          "pattern": "{ value: \"inactive\", label: \"Inactive\" },",
          "paths": [
            "frontend/src/pages/FacilityUsersPage.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "if (profileData?.status?.toLowerCase() === \"inactive\") {",
          "paths": [
            "frontend/src/utils/authStore.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "\"Account is inactive. Please contact your administrator to activate your account.\",",
          "paths": [
            "frontend/src/utils/authStore.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    }
  ]
}
