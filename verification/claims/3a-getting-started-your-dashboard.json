      "id": "yd-r01",
      "claim": "It's personalized by role — a clinician sees different widgets than a practice admin.",
      "checks": [
        {
          "type": "grep",
          "pattern": "(userRole|currentRole) === \"(clinician|admin)\" \\? workCockpits",
          "paths": [
