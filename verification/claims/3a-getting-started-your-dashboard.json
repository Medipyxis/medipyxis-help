{
  "title": "Tour of your dashboard",
  "source": "getting-started/your-dashboard",
  "url": "https://help.medipyxis.com/getting-started/your-dashboard/",
  "claims": [
    {
      "id": "yd-01",
      "claim": "The dashboard is the first page after sign-in; the sidebar shows the modules your role can open; the dashboard cards are the same for everyone.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "  clinical: '/dashboard',",
          "paths": [
            "frontend/src/utils/auth/postAuthDestination.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "return items.filter((item) => facilityCanAccessFeature(item.feature));",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const workCockpits: NavigationCard[] = [",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "yd-02",
      "claim": "Video: platform overview and navigation tour (external YouTube video).",
      "kind": "advice",
      "checks": []
    },
    {
