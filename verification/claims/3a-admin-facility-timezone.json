          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const facilityTz = currentFacility?.timezone || \"America/New_York\";",
          "paths": [
            "frontend/src/pages/ClinicianCalendar.tsx"
