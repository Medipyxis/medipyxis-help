          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "return { allowed: false, reason: \"spend_immutable\" };",
          "paths": [
            "backend/supabase/functions/bd-activity-mutate/authorize.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "  'bd_manager',",
          "paths": [
            "backend/supabase/functions/_shared/auth-helpers.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "bdl-14",
      "claim": "Archive confirm explains exclusion from Next Best Action and MTD spend; archived activities remain in the audit trail and export.",
      "checks": [
        {
          "type": "grep",
          "pattern": "Next Best Action",
          "paths": [
            "frontend/src/pages/CrmPracticeDetail.tsx"
          ],
          "expect": "present",
          "fixed": true
