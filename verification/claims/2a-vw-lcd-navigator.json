          "expect": "present",
          "note": "the wizard is mounted by a routed page"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<VisitWizardV2Page />",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
