    {
      "id": "dme-cr-07",
      "claim": "Save the order as a Draft, or Send Fax / Send Email to dispatch it to the vendor. On sending, the order moves to Submitted.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "\"Save as Draft\"",
          "paths": [
            "frontend/src/pages/PatientOrdersDmePage.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "await OrdersDmeService.recordFaxSend({",
          "paths": [
            "frontend/src/pages/PatientOrdersDmePage.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "pattern": "OrdersDmeService\\.record(Email|Send)",
          "paths": [
            "frontend/src/pages/PatientOrdersDmePage.tsx"
          ],
          "expect": "present",
          "note": "email send would need to record the order as Submitted too"
