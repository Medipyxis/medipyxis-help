          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "path: \"/administrator/practice-onboarding\",",
          "paths": [
            "frontend/src/pages/administrator/AdministratorCockpit.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
