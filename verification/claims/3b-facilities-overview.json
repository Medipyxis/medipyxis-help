{
  "title": "Facilities reference",
  "source": "modules/facilities/overview",
  "url": "https://help.medipyxis.com/modules/facilities/overview/",
  "claims": [
    {
      "id": "fac-01",
      "claim": "The Facilities module (Facility Management) lists the facilities in your organization and lets you add, edit, deactivate and reactivate them.",
      "checks": [
        {
          "type": "grep",
          "pattern": "label: \"Facilities\",",
          "paths": [
            "frontend/src/constants/navigation.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Facility Management",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Manage healthcare facilities and locations across your organization",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "onClick={() => handleToggleStatus(facility)}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "fac-02",
      "claim": "Columns: FACILITY (name, NPI, address), CONTACT (phone, email, fax or No contact), STATS (users, patients, inventory items), STATUS (Active/Inactive), ACTIONS (open page, view details, edit, deactivate/reactivate).",
      "checks": [
        {
          "type": "grep",
          "pattern": "NPI: {facility.npi_code}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "No contact",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{facility.user_count || 0}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{facility.patient_count || 0}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{facility.inventory_count || 0}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{facility.active ? \"Active\" : \"Inactive\"}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "title=\"View detailed page\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "title=\"View Details\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "title=\"Edit\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "fac-03",
      "claim": "Clicking the name opens the facility detail panel; CONTACT shows the primary contact name; STATS shows active providers and visits in the current month; ACTIONS is a ⋯ context menu with View Users.",
      "checks": [
        {
          "type": "grep",
          "pattern": "View Users",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "monthly_visit_count",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Contact shows phone/email/fax, stats are users/patients/inventory, and actions are row buttons with no View Users."
    },
    {
      "id": "fac-04",
      "claim": "Counters show active and inactive facilities and total patients; Active Facilities and Deactivated Facilities tabs; Search facilities filters.",
      "checks": [
        {
          "type": "grep",
          "pattern": "<div className=\"text-xs text-green-700\">Active Facilities</div>",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<div className=\"text-xs text-red-700\">Inactive Facilities</div>",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<div className=\"text-xs text-orange-700\">Total Patients</div>",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<span>Deactivated Facilities</span>",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "placeholder=\"Search facilities...\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "fac-05",
      "claim": "Demo environment counts: 28 total · 11 active · 17 inactive.",
      "checks": [
        {
          "type": "grep",
          "pattern": "28 total",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Demo data snapshot, not a product fact and not checkable in code."
    },
    {
      "id": "fac-06",
      "claim": "Inactive facilities are hidden from scheduling, routing and user assignment, and no new activity can be logged against them; users assigned only to it lose login access.",
      "checks": [
        {
          "type": "grep",
          "pattern": "facility.active",
          "paths": [
            "frontend/src/utils/authStore.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "no_active_facility",
          "paths": [
            "frontend/src/utils/authStore.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Sign-in does not check facility status, so users do not lose login; the verified effect is that the facility drops out of users' facility lists. The broader 'no new activity' claim is not enforced in code. Reworded."
    },
    {
      "id": "fac-07",
      "claim": "Active: the facility appears in users' facility lists. Inactive: it no longer appears in anyone's facility list and its data is kept; a user assigned only to it has no facility to work in.",
      "checks": [
        {
          "type": "grep",
          "pattern": ".in(\"id\", facilityIds)",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": ".eq(\"active\", true);",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": ".update({ active: !currentStatus })",
          "paths": [
            "frontend/src/services/facilityService.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "fac-08",
      "claim": "Select Deactivate from the Actions menu; a confirmation dialog explains the downstream effects.",
      "checks": [
        {
          "type": "grep",
          "pattern": "Are you sure",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Deactivate is a row button with no confirmation dialog."
    },
    {
      "id": "fac-09",
      "claim": "Click Deactivate in the row's actions; there is no confirmation step. It moves to Deactivated Facilities. Reactivate from Deactivated Facilities.",
      "checks": [
        {
          "type": "grep",
          "pattern": "activeTab === \"active\" ? \"Deactivate\" : \"Reactivate\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "await toggleFacilityStatus(facility.id, facility.active);",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "? \"Facility deactivated successfully\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "confirm(",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "absent",
          "fixed": true
        }
      ]
    },
    {
      "id": "fac-10",
      "claim": "Before you deactivate a facility, make sure anyone who works only there has been given access to another facility.",
      "kind": "advice",
      "checks": []
    },
    {
      "id": "fac-11",
      "claim": "Edit updates the facility name, address, NPI, contact, or billing information; changes take effect immediately across all modules.",
      "checks": [
        {
          "type": "grep",
          "pattern": "across all modules",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Reworded to the edit form's actual fields; 'immediately across all modules' is not checkable."
    },
    {
      "id": "fac-12",
      "claim": "Edit updates the facility name, legal / billing name, NPI, tax number, phone, email, fax, address and time zone. Add Facility creates one; when the organization's location limit is reached, Add Facility is disabled.",
      "checks": [
        {
          "type": "grep",
