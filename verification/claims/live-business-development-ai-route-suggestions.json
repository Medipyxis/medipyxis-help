  "claims": [
    {
      "id": "lai-01",
      "claim": "The AI Route Suggestions widget proposes a set of practices worth visiting, prioritizing accounts most likely to yield referrals given current engagement patterns.",
      "checks": [
        {
          "type": "grep",
          "pattern": "likel",
          "paths": [
            "frontend/src/utils/intelligentRouting.ts"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
        }
      ],
      "finding": "There is no likelihood model and no AI call (frontend/src/utils/intelligentRouting.ts:422): fixed rules pick declining-referral, new and high-ROI practices.",
      "proposed_text": "The AI Route Suggestions panel on the Business Development dashboard proposes up to seven practices. Despite the name, it does not use an AI model: it applies fixed rules to referral counts, activity and 30-day ROI.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": "path: \"/facility/:facilityId/bd-dashboard\",",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "<AiSuggestionsAccordion",
          "paths": [
            "frontend/src/pages/BdDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "onAddToRoute={addAiSuggestionToRoute}",
          "paths": [
            "frontend/src/pages/BdDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "const suggestionPromise = generateIntelligentRoute(",
          "paths": [
            "frontend/src/pages/BdDashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "openai",
          "paths": [
            "frontend/src/utils/intelligentRouting.ts"
          ],
          "expect": "absent",
          "fixed": true,
          "ignoreCase": true
        },
        {
          "type": "grep",
          "pattern": "functions.invoke",
          "paths": [
            "frontend/src/utils/intelligentRouting.ts"
          ],
          "expect": "absent",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "const needed = 7 - suggestedPractices.length;",
          "paths": [
            "frontend/src/utils/intelligentRouting.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
