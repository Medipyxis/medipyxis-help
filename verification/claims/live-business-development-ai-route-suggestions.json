    {
      "id": "lai-03",
      "claim": "A refresh reflects your latest logged activity almost immediately.",
      "checks": [
        {
          "type": "grep",
          "pattern": "last_activity_date",
          "paths": [
            "backend/supabase"
          ],
          "expect": "present",
          "fixed": true,
          "note": "something in the product would update practice.last_activity_date when a call or visit is logged"
        },
        {
          "type": "grep",
          "pattern": "bd_activities",
          "paths": [
            "frontend/src/utils/intelligentRouting.ts"
          ],
          "expect": "present",
          "fixed": true,
          "note": "or the rules would read the logged activities directly"
