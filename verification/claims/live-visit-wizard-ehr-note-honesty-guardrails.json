  "claims": [
    {
      "id": "nhl-01",
      "claim": "Your progress note prints only what you documented in the Visit Wizard. Where you did not enter a value, the note says so. It does not fill in clinical details for you.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "primaryICD10: \"E11.621\"",
          "paths": [
            "frontend/src/services/comorbidityMappingService.ts"
          ],
          "expect": "absent"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "secondaryICD10: [\"N18.6\"]",
          "paths": [
            "frontend/src/services/comorbidityMappingService.ts"
          ],
          "expect": "absent"
        }
      ],
      "finding": "Pull Codes suggests type-specific ICD-10 codes when the type or stage was left blank: Type 2 diabetes for a foot or leg wound (comorbidityMappingService.ts frontend/src/services/comorbidityMappingService.ts:52), moderate protein-calorie malnutrition (frontend/src/services/comorbidityMappingService.ts:158) and end-stage renal disease (frontend/src/services/comorbidityMappingService.ts:187). A kept code prints in the note's diagnosis table (frontend/src/services/perfectNote/perfectNoteRenderer.ts:616).",
      "proposed_text": "This page covers two places where the progress note used to fill in clinical details you had not entered: the post-debridement wound area, and the type or stage of a condition. In both places the note now prints only what you documented. One gap remains, in the note's diagnosis codes.",
      "proposed_checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const postMeasure: number | undefined = undefined;",
          "paths": [
            "frontend/src/services/perfectNote/s09_debridement.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const postMeasure = preMeasure",
          "paths": [
            "frontend/src/services/perfectNote/s09_debridement.ts"
          ],
          "expect": {
            "count": 1
          },
          "note": "the only remaining hit is the comment that records the removed line"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "[\"Wound area  -  pre-debridement\", deb.measure_pre_cm2 != null ? `${deb.measure_pre_cm2} cm²` : \"Not measured\"]",
          "paths": [
            "frontend/src/services/perfectNote/perfectNoteRenderer.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "[\"Wound area  -  post-debridement\", deb.measure_post_cm2 != null",
          "paths": [
            "frontend/src/services/perfectNote/perfectNoteRenderer.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "return dt ? `Diabetes mellitus (${dt})` : \"Diabetes mellitus\";",
          "paths": [
            "frontend/src/services/perfectNote/s04_comorbidities.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "return kt ? `Chronic kidney disease (${kt})` : \"Chronic kidney disease\";",
          "paths": [
            "frontend/src/services/perfectNote/s04_comorbidities.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
