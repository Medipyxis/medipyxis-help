    },
    {
      "id": "da-r15",
      "claim": "Deleted accounts remove the link between the user's identity and their historical actions, which breaks audit trail continuity.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Delete User",
          "paths": [
            "frontend/src/pages/HRNewUserPage.tsx"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "Not checkable as stated; there is no delete button for users on these screens."
    }
