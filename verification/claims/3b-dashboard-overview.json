{
  "title": "The Dashboard at a glance",
  "source": "modules/dashboard/overview",
  "url": "https://help.medipyxis.com/modules/dashboard/overview/",
  "claims": [
    {
      "id": "dsh-01",
      "claim": "The Dashboard is the first screen after login; it greets you, links to main work areas, and gathers HR self-service, announcements, recent activity and reference material.",
      "checks": [
        {
          "type": "grep",
          "pattern": "label: \"Dashboard\",",
          "paths": [
            "frontend/src/constants/navigation.ts"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Welcome Back, {userFullName || \"User\"}!",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Your Work Cockpits",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "HR Self-Service",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Recent Activity",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Knowledge Base & Resources",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "dsh-02",
      "claim": "The Welcome Back banner shows your current facility; the HIPAA badge confirms your session is audit-logged.",
      "checks": [
        {
          "type": "grep",
          "pattern": "audit",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
        }
      ],
      "status": "removed",
      "reason": "The banner shows name, job title and role; the HIPAA badge is a static label with no audit behaviour behind it."
    },
    {
      "id": "dsh-03",
      "claim": "Welcome Back banner: your name, job title and role, an On Duty pill and a HIPAA badge.",
      "checks": [
        {
          "type": "grep",
          "pattern": "{profile.job_title}",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{profile?.role || \"Team Member\"}",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "On Duty",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "HIPAA",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "dsh-04",
      "claim": "Action tiles — dynamic cards for referrals needing review, visits scheduled today, denials needing appeal, and credentials expiring; tiles surface by urgency (red border SLA breach, yellow due today, grey informational).",
      "checks": [
        {
          "type": "grep",
          "pattern": "denial",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
        },
        {
          "type": "grep",
          "pattern": "SLA",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "No such action tiles or urgency ordering exist on the Dashboard."
    },
    {
      "id": "dsh-05",
      "claim": "Click the gear in any tile header to hide or pin it; click Reset in the profile menu to restore defaults.",
      "checks": [
        {
          "type": "grep",
          "pattern": "Reset",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "pinned",
          "paths": [
            "frontend/src/pages/Dashboard.tsx"
          ],
          "expect": "present",
          "fixed": true,
          "ignoreCase": true
        }
      ],
      "status": "removed",
      "reason": "There is no tile gear, pin/hide, or Reset control."
    },
    {
      "id": "dsh-06",
      "claim": "Your Work Cockpits: Patient Management, Clinical Workflow and Mileage & Expenses.",
      "checks": [
