    {
      "id": "dsh-09",
      "claim": "Sidebar: a biller will not see Fleet Calendar, a BD rep will not see Billing Operations.",
      "checks": [
        {
          "type": "grep",
          "pattern": "  biller: [",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Visibility depends on the organization's role settings; only the default fallbacks are in code. Reworded generally."
    },
    {
      "id": "dsh-10",
      "claim": "Sidebar: you see only the modules your role can open.",
      "checks": [
        {
          "type": "grep",
          "pattern": "return items.filter((item) => facilityCanAccessFeature(item.feature));",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "dsh-11",
      "claim": "Top bar has an Organization Selector.",
      "checks": [
        {
          "type": "grep",
          "pattern": "Organization Selector",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "The top bar has Quick jump, notifications and the profile menu; an organization selector control was not found under that name."
    },
    {
      "id": "dsh-12",
      "claim": "Top bar: Quick jump search (⌘K or Ctrl+K), the notifications bell, and your profile menu with Sign Out.",
      "checks": [
        {
          "type": "grep",
          "pattern": "if ((event.metaKey || event.ctrlKey) && event.key === \"k\") {",
