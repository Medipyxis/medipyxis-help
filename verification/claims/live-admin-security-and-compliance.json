  "claims": [
    {
      "id": "sc-x1",
      "claim": "Medipyxis is built to the HIPAA Security Rule.",
      "kind": "external",
      "note": "Compliance statement; not checkable in product code."
    },
    {
      "id": "sc-x2",
      "claim": "This page explains how session controls, audit logging, access control, and BAAs work.",
      "kind": "advice"
    },
    {
      "id": "sc-03",
      "claim": "HIPAA requires covered entities to implement automatic logoff for electronic PHI systems (45 CFR §164.312(a)(2)(iii)).",
      "kind": "external"
    },
    {
      "id": "sc-01a",
      "claim": "Medipyxis enforces automatic logoff: after about 30 minutes of inactivity the session ends and the user must sign in again.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "timeout = 30 * 60 * 1000,",
          "paths": [
            "frontend/src/hooks/useAutoLogout.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "toast.error(\"Signed out due to inactivity.\");",
          "paths": [
            "frontend/src/hooks/useAutoLogout.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "sc-f02",
      "claim": "The timeout is approximately 30 minutes for clinical roles.",
      "checks": [
        {
          "type": "grep",
          "pattern": "useAutoLogout\\(\\{ enabled: .*(role|isClinical)",
          "paths": [
            "frontend/src/components/AppProvider.tsx"
