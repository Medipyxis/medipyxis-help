    {
      "id": "inv-pc-01",
      "claim": "You must have the vendor_coordinator or admin role to add or edit products.",
      "checks": [
        {
          "type": "grep",
          "pattern": "vendor_coordinator|isAdmin|currentRole",
          "paths": [
            "frontend/src/pages/inventory-management/product-catalog/Products.tsx",
            "frontend/src/pages/inventory-management/product-catalog/AddEditProduct.tsx",
            "frontend/src/pages/inventory-management/product-catalog/ProductCatalog.tsx"
          ],
          "expect": "present",
          "note": "a role gate on Add Product / Edit"
        }
      ],
      "finding": "No role check: Products.tsx, AddEditProduct.tsx and ProductCatalog.tsx never test the role. Any user with the Inventory feature can open /inventory-management/product-catalog (user-routes.tsx:2132) and add or edit products. The save is a direct PostgREST insert/update on inventory_product_catalog_v2 (AddEditProduct.tsx:903-918).",
      "proposed_text": "Anyone whose role has the Inventory feature can add or edit products.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": "path: \"/inventory-management/product-catalog\",",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
