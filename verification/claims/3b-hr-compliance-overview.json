          "type": "grep",
          "pattern": "\"HR & Compliance\",",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "absent",
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "Access is by role feature settings, not admin-only (clinical managers and BD managers have it by default), and no dashboard widget for assigned education was found."
    },
