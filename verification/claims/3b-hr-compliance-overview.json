        {
          "type": "grep",
          "pattern": "path: \"/facility/:facilityId/hr\",",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "return <HrCockpit />;",
          "paths": [
            "frontend/src/pages/Hr.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "Human Resources Hub",
          "paths": [
            "frontend/src/pages/HrCockpit.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "      title: \"",
          "paths": [
            "frontend/src/pages/HrCockpit.tsx"
