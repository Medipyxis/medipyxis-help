      "claim": "Go to https://app.medipyxis.com/login.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "  return hostname === 'app.medipyxis.com';",
          "paths": [
            "frontend/src/utils/envValidation.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "['/login', '/forgot-password', '/create-password', '/auth/callback']",
          "paths": [
            "frontend/src/utils/fetchPolyfill.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
