  "claims": [
    {
      "id": "lmd-01",
      "claim": "See the visits assigned to you for the day and launch each one from your calendar.",
      "checks": [
        {
          "type": "grep",
          "pattern": "<AppointmentDetailsModal",
          "paths": [
            "frontend/src/pages/ops/FleetCalendarCanvas.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "await openVisitWizard(",
          "paths": [
            "frontend/src/components/AppointmentDetailsModal.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
    {
      "id": "lmd-02",
      "claim": "Before you start: you are logged in as yourself; appointments have been scheduled for you on the Fleet Calendar. If nothing appears for today, contact your scheduler.",
      "kind": "advice"
    },
    {
      "id": "lmd-03",
      "claim": "Open My Calendar. Click My Calendar in the sidebar to see the appointments assigned to you.",
      "checks": [
        {
          "type": "grep",
          "pattern": "label: \"My Calendar\",",
          "paths": [
            "frontend/src/constants/navigation.ts"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "finding": "My Calendar is not a sidebar item; it is routed at /facility/:facilityId/my-calendar (frontend/src/user-routes.tsx:718) and opened from the Calendar button on the Patient Management page (frontend/src/pages/PmClinicianDashboard.tsx:163). It has no Start Visit button.",
      "proposed_text": "Open the Fleet Calendar and use the All Providers filter to show only your own column. You can also open My Calendar with the Calendar button on the Patient Management page; it lists only your appointments, but it has no Start Visit button.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": "? \"All Providers\"",
          "paths": [
            "frontend/src/pages/ops/FleetCalendarCanvas.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "`/facility/${currentFacility.id}/my-calendar`",
          "paths": [
            "frontend/src/pages/PmClinicianDashboard.tsx"
