  "claims": [
    {
      "id": "inv-ivr-01",
      "claim": "The vendor_coordinator or practice_admin role is required to create and update IVRs.",
      "checks": [
        {
          "type": "grep",
          "pattern": "practice_admin",
          "paths": [
            "frontend/src",
            "backend/supabase/functions"
          ],
          "expect": "present",
          "fixed": true
        }
      ],
      "finding": "No practice_admin role exists. IVR Tracking is gated by the Inventory feature only (user-routes.tsx:2164-2168); status changes go through update_ivr_order_status_v2 with no role list in the page.",
      "proposed_text": "Anyone whose role has the Inventory feature can update IVRs in IVR Tracking.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": "<IVRManagementPage />",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": {
            "count": 2
          },
          "fixed": true
        }
      ],
      "status": "removed",
      "reason": "No practice_admin role exists; IVR Tracking is gated by the Inventory feature only. Replaced by inv-ivr-14."
    },
    {
      "id": "inv-ivr-02",
