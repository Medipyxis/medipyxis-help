{
  "title": "Set up a facility in your first week",
  "source": "admin/facility-setup",
  "url": "https://help.medipyxis.com/admin/facility-setup/",
  "claims": [
    {
      "id": "fs-01",
      "claim": "Complete these tasks during the first week after a new facility goes live.",
      "kind": "advice",
      "checks": []
    },
    {
      "id": "fs-02",
      "claim": "You can open Facilities in the sidebar. Administrators always can.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "label: \"Facilities\",",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<RequireFeature feature=\"Facilities\">",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "// (2026-05-17): \"admin should be like superadmin of their own account, until",
          "paths": [
            "frontend/src/contexts/FacilityContext.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-03",
      "claim": "If you work at more than one facility, open your profile menu (top right), click Switch Facility, and pick the facility.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "{/* Switch Facility Button */}",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "disabled={activeFacilitiesCount <= 1 || !isOnline}",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Switch Facility",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-04",
      "claim": "The URL reads /facility/{uuid}/dashboard; the uuid part is the facility's ID.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "path: \"/facility/:facilityId/dashboard\",",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "const path = `/facility/${currentFacility.id}/dashboard`;",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-05",
      "claim": "Medipyxis support may ask for the facility ID.",
      "kind": "advice",
      "checks": []
    },
    {
      "id": "fs-06",
      "claim": "Image: Facilities list with FACILITY, CONTACT, STATS, STATUS and ACTIONS columns; the Active/Inactive badge in STATUS.",
      "checks": [
        {
          "type": "grep",
          "pattern": "^\\s+Stats$",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "pattern": "^\\s+Actions$",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "{facility.active ? \"Active\" : \"Inactive\"}",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-07",
      "claim": "Facilities → Edit button on your facility's row → Fax Number → Save Changes.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "title=\"Edit\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "pattern": "^\\s+Fax Number$",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<span className=\"text-xs sm:text-sm\">Save Changes</span>",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-08",
      "claim": "Faxes sent from Medipyxis for this facility go out from this number, so it must be set up for the facility's fax service; sending is refused while it is blank.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "error: \"Facility has no fax caller ID configured\",",
          "paths": [
            "backend/supabase/functions/send-fax/index.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "\"Set facility.fax to a Documo-registered number for this facility before sending.\",",
          "paths": [
            "backend/supabase/functions/send-fax/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-09",
      "claim": "Faxes received on that number are filed to this facility.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "normalizePhoneNumber(f.fax || \"\") === normalizedRecipient",
          "paths": [
            "backend/supabase/functions/receive-fax-webhook/index.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "facility_id = matchedFacility.id;",
          "paths": [
            "backend/supabase/functions/receive-fax-webhook/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-10",
      "claim": "In the facility form, enter the NPI Code and Tax Number.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "NPI Code",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Tax Number",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-11",
      "claim": "When you enter a 10-digit NPI, Medipyxis looks it up in the NPPES registry and shows a Found in federal NPPES registry card; Use this info fills the Legal / Billing Name, address and phone, Dismiss keeps what you typed.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Found in federal NPPES registry",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "legal_name: s.organizationName || s.displayName || prev.legal_name,",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "phone: normalizedPhone || prev.phone,",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "// dismiss path leaves form fields untouched.",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-12",
      "claim": "If the registry cannot confirm the NPI, saving stops with \"We can't confirm this NPI is a real registered provider\" and a Save anyway button.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "'We can\\'t confirm this NPI is a real registered provider. Use \"Save anyway\" below if this is a test/dev facility.',",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "data-testid=\"nppes-save-anyway\"",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-13",
      "claim": "The Legal / Billing Name is the name used on claims; if it is blank, claims use the Facility Name.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "billing_provider_name: facility?.legal_name || facility?.name || undefined,",
          "paths": [
            "frontend/src/services/autoBillingClaimService.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-14",
      "claim": "Click Billing Operations, then Charge Master; add rates in Insurance Charges and Self-Pay Charges.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "label: \"Billing Operations\",",
          "paths": [
            "frontend/src/components/AppShell.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "navigate(`/facility/${facilityPathId}/billing/charge-master`)",
          "paths": [
            "frontend/src/pages/BillingDashboard.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<DollarSign className=\"h-4 w-4\" /> Insurance Charges",
          "paths": [
            "frontend/src/pages/ChargeMasterPage.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<Users className=\"h-4 w-4\" /> Self-Pay Charges",
          "paths": [
            "frontend/src/pages/ChargeMasterPage.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-15",
      "claim": "A claim line with no rate is priced at $0.00 and the claim cannot be sent to Stedi; the message reads No price on file for CPT ….",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "status: \"needs_pricing\",",
          "paths": [
            "frontend/src/lib/billing/charge_master.ts"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "message: `No price on file for ${label}${atFacility} — add it in Charge Master.`,",
          "paths": [
            "backend/supabase/functions/_shared/validateClaimLineCharges.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-16",
      "claim": "A facility not in the list was deactivated: open the Deactivated Facilities tab and click Reactivate on its row.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "<span>Deactivated Facilities</span>",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "activeTab === \"active\" ? \"Deactivate\" : \"Reactivate\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-17",
      "claim": "Sending a fax fails with \"Facility has no fax caller ID configured\" when the facility's Fax Number is blank.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "error: \"Facility has no fax caller ID configured\",",
          "paths": [
            "backend/supabase/functions/send-fax/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "fs-r01",
      "claim": "You need the admin or superadmin role.",
      "checks": [
        {
          "type": "grep",
          "pattern": "(userRole|currentRole) (!==|===) \"admin\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "Access is the Facilities feature. Replaced by fs-02."
    },
    {
      "id": "fs-r02",
      "claim": "Open the Organization Selector in the top-left header and select the facility.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Organization Selector",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "There is no Organization Selector; switching is Switch Facility in the profile menu. Replaced by fs-03."
    },
    {
      "id": "fs-r03",
      "claim": "Share this UUID with any integration partners or API consumers; it is the stable identifier for this facility across all Medipyxis APIs.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "facility_uuid",
          "paths": [
            "backend/supabase/functions/vendor-api"
          ],
          "expect": "present",
          "note": "would hold if a public API took the facility ID"
        }
      ],
      "status": "removed",
      "reason": "There is no customer-facing Medipyxis API that takes a facility ID. Dropped."
    },
    {
      "id": "fs-r04",
      "claim": "Click Actions → Edit next to your facility; enter the 10-digit fax number (no dashes or spaces required); click Save.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Actions → Edit",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "There is no Actions menu (Edit is a row button) and the button is Save Changes. Replaced by fs-07."
    },
    {
      "id": "fs-r05",
      "claim": "The fax number entered here is the outbound caller ID shown to referring practices. Inbound faxes are routed via the More (Fax) module; this field does not change inbound routing.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "normalizePhoneNumber(f.fax || \"\") === normalizedRecipient",
          "paths": [
            "backend/supabase/functions/receive-fax-webhook/index.ts"
          ],
          "expect": "absent"
        }
      ],
      "status": "removed",
      "reason": "Inbound faxes are matched to a facility by this number. Replaced by fs-08/fs-09."
    },
    {
      "id": "fs-r06",
      "claim": "NPI and Tax ID are both format-validated as you type; NPPES offers to auto-fill legal name, address, and taxonomy; a Save anyway? prompt appears.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Save anyway?</",
          "paths": [
            "frontend/src/components/FacilityAddEditModal.tsx"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "Validation runs on save, the card fills phone not taxonomy text, and the button reads Save anyway. Replaced by fs-11/fs-12."
    },
    {
      "id": "fs-r08",
      "claim": "Set business hours: expand Business Hours, toggle each day, set Open and Close in 30-minute increments; business hours drive the SLA breach timer on the Fax Review Queue and Referral Intake kanban.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Business Hours",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "There is no Business Hours setting anywhere in the product."
    },
    {
      "id": "fs-r09",
      "claim": "Set intake SLAs in Referral Intake Settings: New Referral SLA and Financial Clearance SLA drive the red SLA Breach Timer on each referral card.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "New Referral SLA",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Financial Clearance SLA",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "There are no configurable intake SLA settings."
    },
    {
      "id": "fs-r10",
      "claim": "Billing → Charge Master: under the Templates tab set the default superbill template, and confirm the Default Rendering Provider NPI so it populates CMS-1500 24J on every new claim.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Default Rendering Provider",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "There is no default template or Default Rendering Provider setting in the Charge Master. Replaced by fs-14."
    },
    {
      "id": "fs-r11",
      "claim": "Result: enforces business-hour SLAs on Referral Intake and auto-populates a default rendering provider on new claims.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Business Hours",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Default Rendering Provider",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        }
      ],
      "status": "removed",
      "reason": "Neither setting exists."
    },
    {
      "id": "fs-r12",
      "claim": "Troubleshooting: facility shows Inactive — not yet activated by Medipyxis support; SLA timer never turns red — business hours not saved; default rendering provider blank — field not set.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Business Hours",
          "paths": [
            "frontend/src"
          ],
          "expect": "present"
        },
        {
          "type": "grep",
          "fixed": true,
          "pattern": "activeTab === \"active\" ? \"Deactivate\" : \"Reactivate\"",
          "paths": [
            "frontend/src/pages/FacilityDashboard.tsx"
          ],
          "expect": "absent"
        }
      ],
      "status": "removed",
      "reason": "Admins can reactivate a facility themselves, and the SLA and rendering-provider settings do not exist. Replaced by fs-16 to fs-17."
    }
  ]
}
