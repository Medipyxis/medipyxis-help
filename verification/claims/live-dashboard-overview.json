      "id": "ldo-01",
      "claim": "Your Dashboard is the first screen you see after login.",
      "checks": [
        {
          "type": "grep",
          "pattern": "({ kind: 'pane', pane: 'clinical', path: '/dashboard' } as const);",
          "paths": [
            "frontend/src/pages/Login.tsx"
          ],
          "expect": "present",
          "fixed": true
        },
        {
          "type": "grep",
          "pattern": "{ path: \"/dashboard\", element: <Dashboard /> },",
          "paths": [
            "frontend/src/user-routes.tsx"
          ],
          "expect": "present",
          "fixed": true
        }
      ]
    },
