      "finding": "No receiving path compares the lot to the suffix. A suffix only makes the lot required on bulk upload (BulkUploadOrderModal.tsx:1158-1183).",
      "proposed_text": "Lot # — manufacturer lot number; required at receiving.",
      "proposed_checks": [
        {
          "type": "grep",
          "pattern": "toast.error(`Lot number is required for ${item.product_name}`);",
          "paths": [
            "frontend/src/pages/inventory-management/product-batches/ManualReceiveModal.tsx"
