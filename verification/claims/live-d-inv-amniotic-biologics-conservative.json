      "id": "inv-abc-07",
      "claim": "Lot # is validated against the product's LOT SUFFIX in the Product Catalog.",
      "checks": [
        {
          "type": "grep",
          "pattern": "endsWith\\(|startsWith\\(",
          "paths": [
