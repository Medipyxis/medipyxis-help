        {
          "type": "grep",
          "fixed": true,
          "pattern": "// Creates catalog_links rows with status='proposed' for clinic review.",
          "paths": [
            "backend/supabase/functions/vendor-catalog-push/index.ts"
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "vpf-08",
      "claim": "You send invoices from the Invoices page. The clinic's finance team reconciles and pays them in their Accounts Payable workspace. You track status from your Invoices list.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "Send to clinic",
