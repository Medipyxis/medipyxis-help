    {
      "id": "vpf-11",
      "claim": "Is the vendor portal the same login as the clinical app? No. The vendor portal is a separate sign-in at /vendor.",
      "checks": [
        {
          "type": "grep",
          "fixed": true,
          "pattern": "path=\"/login\"",
          "paths": [
            "frontend/src/pages/vendor/VendorRoutes.tsx"
          ],
          "expect": "present"
        }
      ],
      "finding": "There is no vendor sign-in page; everyone signs in at /login and a vendor account is sent to /vendor/home (postAuthDestination.ts, VendorRoutes.tsx at v1.1.345).",
